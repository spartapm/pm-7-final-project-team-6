# Vercel Environment Variables에도 같은 이름으로 넣습니다.
# NEXT_PUBLIC_ 값은 빌드 시 클라이언트에 들어가므로, DB password / service role은 넣지 마세요.

NEXT_PUBLIC_SUPABASE_URL=https://gqlnvqgjzlsjjnnqizcm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 테이블 생성(npm run db:schema)할 때만 필요. 앱 런타임에는 쓰지 않습니다.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.gqlnvqgjzlsjjnnqizcm.supabase.co:5432/postgres
